# App & Base URLs
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"

# Database (PostgreSQL - Neon)
DATABASE_URL="postgresql://neondb_owner:password@ep-spring-violet-b45zdq5p.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://neondb_owner:password@ep-spring-violet-b45zdq5p.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication & Security
AUTH_SECRET="f63c8a91b29d47a0b5c1e9a4f6d8c0b2f63c8a91b29d47a0b5c1e9a4f6d8c0b2"
SESSION_MAX_AGE_SECONDS="604800"
ARGON2_MEMORY_COST="65536"

# Object Storage (Neon Object Storage / S3-Compatible)
S3_ENDPOINT="https://br-old-mountain-b4e96aat.storage.c-6.us-east-2.aws.neon.tech"
S3_REGION="us-east-2"
S3_BUCKET_NAME="assets"
S3_ACCESS_KEY_ID="your-neon-access-key"
S3_SECRET_ACCESS_KEY="your-neon-secret-key"
NEXT_PUBLIC_CDN_BASE_URL="https://br-old-mountain-b4e96aat.storage.c-6.us-east-2.aws.neon.tech/assets"

# Transactional Email (Verification & Password Reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM_ADDRESS="no-reply@repasters.org"

# Rate Limiting, Pagination & Upload Thresholds
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="30"
RATE_LIMIT_AUTH_MAX_REQUESTS="5"
DEFAULT_PAGE_SIZE="12"
MAX_PAGE_SIZE="50"
MAX_IMAGE_UPLOAD_BYTES="5242880"

# Food Expiry, Distribution & 3-Month Soft-Delete Retention (2160 Hours = 3 Months)
CRON_SECRET="f63c8a91b29d47a0b5c1e9a4f6d8c0b2"
MAX_OFFERING_DURATION_HOURS="72"
EXPIRED_RETENTION_HOURS="2160"
DISTRIBUTED_RETENTION_HOURS="2160"

# Advertising Configuration
NEXT_PUBLIC_ENABLE_ADS="true"
NEXT_PUBLIC_AD_PROVIDER_SCRIPT_URL=""
NEXT_PUBLIC_AD_SLOT_DESKTOP_RAIL_ID="slot-desktop-rail"
NEXT_PUBLIC_AD_SLOT_MOBILE_FEED_ID="slot-mobile-feed"
